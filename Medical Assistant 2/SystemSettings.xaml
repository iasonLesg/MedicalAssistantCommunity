<Window x:Class="MedicalAssistantCommunity.SystemSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MedicalAssistantCommunity"
        mc:Ignorable="d"
        Title="SystemSettings" Height="450" Width="800">
   <Grid Margin="40">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/> <!-- Title -->
        <RowDefinition Height="*"/>    <!-- Settings Content -->
        <RowDefinition Height="Auto"/> <!-- Action Buttons -->
    </Grid.RowDefinitions>

    <!-- 1. Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5">
                <!-- Cogwheel (Placed first to appear on the left) -->
                <Path Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.13,5.91,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.81,11.69,4.81,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.5c-1.93,0-3.5-1.57-3.5-3.5 s1.57-3.5,3.5-3.5s3.5,1.57,3.5,3.5S13.93,15.5,12,15.5z" 
          Fill="{StaticResource SecondaryColor}" 
          Stretch="Uniform" 
          Height="14" 
          Width="14" 
          Margin="0,0,6,0" 
          VerticalAlignment="Center"/>

                <!-- Text -->
                <TextBlock Name="ConfigurationLabel" 
               Text="Configuration" 
               FontSize="12" 
               FontWeight="Bold" 
               Foreground="{StaticResource SecondaryColor}" 
               VerticalAlignment="Center"/>
            </StackPanel>
            <!-- Changed TextNavy to TextDark -->
            <TextBlock Name="SystemSettingsLabel" Text="System Settings" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
        </StackPanel>

        <!-- 2. Settings Card -->
    <Border Grid.Row="1" 
            Background="White" 
            CornerRadius="15" 
            Padding="30" 
            VerticalAlignment="Top">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Direction="-90" RenderingBias="Quality" ShadowDepth="2" Opacity="0.05"/>
        </Border.Effect>

        <StackPanel>
            <!-- Language Selection Section -->
                <TextBlock Name="InterfaceLanguageLabel" Text="Interface Language" FontWeight="Bold" FontSize="16" Margin="0,0,0,15" Foreground="{StaticResource TextDark}"/>
            
            <Grid Width="400" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                    <TextBlock Name="SelectLanguageLabel" Text="Select Language:" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="{StaticResource TextGrey}"/>

                <!-- Language Dropdown -->
                <ComboBox Name="LanguagePicker" 
                          Grid.Column="1"
                          Style="{StaticResource ModernComboBox}" 
                          Height="40"
                          SelectedValuePath="Tag">
                    <ComboBoxItem Content="English" Tag="en" IsSelected="True"/>
                    <ComboBoxItem Content="Greek (Ελληνικά)" Tag="el"/>
                    <ComboBoxItem Content="Spanish (Español)" Tag="es"/>
                    <ComboBoxItem Content="Chinese (简体中文)" Tag="zh"/>
                    <ComboBoxItem Content="Hindi (हिन्दी)" Tag="hi"/>
                    <ComboBoxItem Content="Arabic (العربية)" Tag="ar"/>
                    <ComboBoxItem Content="Portuguese (Português)" Tag="pt"/>
                    <ComboBoxItem Content="Bengali (বাংলা)" Tag="bn"/>
                    <ComboBoxItem Content="Russian (Русский)" Tag="ru"/>
                    <ComboBoxItem Content="Japanese (日本語)" Tag="jp"/>
                    <ComboBoxItem Content="Punjabi (ਪੰਜਾਬੀ)" Tag="pa"/>
                    <ComboBoxItem Content="German (Deutsch)" Tag="de"/>
                    <ComboBoxItem Content="Javanese (Basa Jawa)" Tag="jv"/>
                    <ComboBoxItem Content="Korean (한국어)" Tag="ko"/>
                    <ComboBoxItem Content="French (Français)" Tag="fr"/>
                    <ComboBoxItem Content="Telugu (తెలుగు)" Tag="te"/>
                    <ComboBoxItem Content="Marathi (मराठी)" Tag="mr"/>
                    <ComboBoxItem Content="Turkish (Türkçe)" Tag="tr"/>
                    <ComboBoxItem Content="Tamil (தமிழ்)" Tag="ta"/>
                    <ComboBoxItem Content="Vietnamese (Tiếng Việt)" Tag="vi"/>
                    <ComboBoxItem Content="Urdu (اردو)" Tag="ur"/>
                    <ComboBoxItem Content="Italian (Italiano)" Tag="it"/>
                    <ComboBoxItem Content="Thai (ไทย)" Tag="th"/>
                    <ComboBoxItem Content="Gujarati (ગુજરાતી)" Tag="gu"/>
                    <ComboBoxItem Content="Polish (Polski)" Tag="pl"/>
                    <ComboBoxItem Content="Ukrainian (Українська)" Tag="uk"/>
                    <ComboBoxItem Content="Persian (فارسی)" Tag="fa"/>
                    <ComboBoxItem Content="Malay (Bahasa Melayu)" Tag="ms"/>
                    <ComboBoxItem Content="Romanian (Română)" Tag="ro"/>
                    <ComboBoxItem Content="Dutch (Nederlands)" Tag="nl"/>
                </ComboBox>
            </Grid>
            
            <Separator Margin="0,30" Background="{StaticResource PressedGrey}"/>
            <!-- You can add more settings rows here easily -->
        </StackPanel>
    </Border>

    <!-- 3. Footer Action Buttons -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
        <!-- Cancel Button -->
        <Button Name="Settings_cancel_Label"
            Content="Cancel" 
                Width="100" 
                Height="40" 
                Background="Transparent" 
                Foreground="{StaticResource TextGrey}" 
                FontWeight="SemiBold"
                BorderThickness="0"
                Margin="0,0,15,0"
                Cursor="Hand"
                Click="CancelSettings_Click"/>

        <!-- Save Button -->
            <Button Name="Settings_Save_Label"
            Content="Save Changes" 
                Width="150" 
                Height="40" 
                Background="{StaticResource BrandGradient}" 
                Foreground="White" 
                FontWeight="Bold"
                BorderThickness="0"
                Cursor="Hand"
                Click="SaveSettings_Click">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="20"/>
                </Style>
            </Button.Resources>
        </Button>
    </StackPanel>
</Grid>
</Window>
