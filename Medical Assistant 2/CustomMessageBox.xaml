<Window x:Class="MedicalAssistantCommunity.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notification" Height="200" Width="350"
        WindowStartupLocation="CenterOwner" WindowStyle="None" 
        AllowsTransparency="True" Background="Transparent">

    <Border CornerRadius="15" Background="White" BorderBrush="{StaticResource PressedGrey}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Direction="-90" Opacity="0.1"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <!-- Message Text -->
                <RowDefinition Height="Auto"/>
                <!-- Button -->
            </Grid.RowDefinitions>

            <TextBlock x:Name="MessageText" 
                       Text="Your message goes here." 
                       TextWrapping="Wrap" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       FontSize="14" 
                       Foreground="{StaticResource TextDark}"/>

            <Button Grid.Row="1" 
                    Content="OK" 
                    Width="100" Height="35" 
                    Background="{StaticResource BrandGradient}"
                    Foreground="White" 
                    FontWeight="Bold" 
                    Click="Ok_Click"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Border>
</Window>