<Window x:Class="MedicalAssistantCommunity.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System Authentication" Height="650" Width="500"
        WindowStartupLocation="CenterScreen" 
        Background="Transparent"
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True">

    <Border CornerRadius="20" Background="White" Margin="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Direction="-90" Opacity="0.1"/>
        </Border.Effect>

        <!-- Use a Grid to allow top-right positioning -->
        <Grid>
            <!-- 1. TOP RIGHT SETTINGS SECTION -->
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Top" 
                        Margin="15">

                <!-- Language Label (Optional) -->
                <TextBlock Name="Lbl_Lng" Text="EN" VerticalAlignment="Center" 
                           Foreground="{StaticResource TextGrey}" 
                           FontSize="11" FontWeight="Bold" Margin="0,0,8,0"/>

                <!-- Settings Button (Cogwheel) -->
                <Button x:Name="SettingsBtn" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="ChangeLanguadge_click">
                    <Path Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L13.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L8.25,5.29C7.66,5.53,7.12,5.85,6.62,6.23L4.23,5.27c-0.22-0.08-0.47,0-0.59,0.22L1.72,8.81 c-0.11,0.2-0.06,0.47,0.12,0.61l2.03,1.58C3.82,11.3,3.8,11.62,3.8,11.94c0,0.32,0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.11-0.2,0.06-0.47-0.12-0.61L19.14,12.94z M12,15.6c-2.02,0-3.66-1.64-3.66-3.66 c0-2.02,1.64-3.66,3.66-3.66c2.02,0,3.66,1.64,3.66,3.66C15.66,13.96,14.02,15.6,12,15.6z" 
                          Fill="{StaticResource TextGrey}" 
                          Width="18" Height="18" Stretch="Uniform"/>
                </Button>
            </StackPanel>

            <!-- 2. LOGIN FORM CONTENT (Your original StackPanel) -->
            <StackPanel Margin="30">
                <!-- Header (Logo + Text) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <!-- Logo Container -->
                    <Grid Width="30" Height="30" Margin="0,0,12,0">
                        <!-- BACKGROUND: The Medical Cross -->
                        <Path Data="{StaticResource MedicalCrossTransparentCenter}" 
              Fill="{StaticResource lOGOSecondaryColor}" 
              Stretch="Uniform"/>

                        <!-- FOREGROUND: The Abstract Logo -->
                        <Path Data="{StaticResource AbstractElement}" 
              Fill="{StaticResource lOGOPrimaryColor}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
                            <Path.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1.4" ScaleY="1.4" CenterX="7" CenterY="7"/>
                                    <TranslateTransform X="-0.5" Y="1"/>
                                </TransformGroup>
                            </Path.RenderTransform>
                        </Path>
                    </Grid>

                    <!-- Text Group: Title and Tag -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Medical Assistant" 
                   FontSize="20" 
                   FontWeight="Black" 
                   Foreground="{StaticResource BrandGradient}"
                   LineHeight="20"/>

                        <!-- Professional Community Tag -->
                        <Border Background="{StaticResource CommunityBrush}" 
                CornerRadius="3" 
                Padding="5,1,5,1" 
                HorizontalAlignment="Left" 
                Margin="0,2,0,0">
                            <TextBlock Text="COMMUNITY EDITION" 
                       FontSize="9" 
                       FontWeight="ExtraBold" 
                                       Background="Transparent"
                       Foreground="White" 
                       />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="TitleTxt" Text="Welcome Back" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center" Margin="0,30,0,0"/>
                <TextBlock x:Name="SubTitleTxt" Text="Please login to access patient data" FontSize="12" Foreground="{StaticResource TextGrey}" HorizontalAlignment="Center" Margin="0,5,0,25"/>

                <!-- Warning Box -->
                <Border x:Name="WarningBox" Visibility="Collapsed" Background="#FFF4F4" CornerRadius="10" Padding="15" Margin="0,0,0,20" BorderBrush="#FFCCCC" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Name="LBL_Important" Text="IMPORTANT:" FontWeight="Bold" Foreground="#D32F2F" FontSize="12"/>
                        <TextBlock Name="LBL_LostText" Text="Lost passwords cannot be recovered by the developer. Your data is encrypted locally using this password." 
                                   TextWrapping="Wrap" Foreground="#D32F2F" FontSize="11" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Inputs -->
                <TextBlock Name="LBL_Username" Text="Username" FontSize="11" FontWeight="Bold" Margin="5,0,0,5" Foreground="{StaticResource TextGrey}"/>
                <Border Background="{StaticResource AppBackground}" CornerRadius="10" Padding="5" Margin="0,0,0,15">
                    <TextBox x:Name="UsernameInput" Background="Transparent" BorderThickness="0" Padding="10,5" FontSize="14"/>
                </Border>

                <TextBlock Name="LBL_Password" Text="Password" FontSize="11" FontWeight="Bold" Margin="5,0,0,5" Foreground="{StaticResource TextGrey}"/>
                <Border Background="{StaticResource AppBackground}" CornerRadius="10" Padding="5" Margin="0,0,0,25">
                    <PasswordBox x:Name="PasswordInput" Background="Transparent" BorderThickness="0" Padding="10,5" FontSize="14"/>
                </Border>

                <!-- Buttons -->
                <Button x:Name="MainBtn" Content="Login" Height="45" Background="{StaticResource BrandGradient}" 
                        Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="MainBtn_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Name="BTN_EXIT" Content="Exit Application" Margin="0,15,0,0" Background="Transparent" BorderThickness="0" 
                        Foreground="{StaticResource TextGrey}" FontSize="11" Click="Exit_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>