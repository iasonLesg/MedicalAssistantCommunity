        <DrawingImage x:Key="IconPrescriptionInActive">
            <DrawingImage.Drawing>
                <GeometryDrawing Geometry="{StaticResource PrescriptionPath}" Brush="#c4c4c4"/>
            </DrawingImage.Drawing>
