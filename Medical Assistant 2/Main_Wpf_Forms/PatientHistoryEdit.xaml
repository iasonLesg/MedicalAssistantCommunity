<Window x:Class="MedicalAssistantCommunity.PatientHistoryEdit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Patient History Editor" Height="850" Width="1250"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- Style for the text inputs -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="Background" Value="#FAFBFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Style.Resources>
        </Style>

        <!-- Combined History Icon Geometry -->
        <Geometry x:Key="HistoryIconPath">
            M256,0C114.6,0,0,114.6,0,256s114.6,256,256,256s256-114.6,256-256S397.4,0,256,0z M310.6,341.4c-6.2,6.2-16.4,6.2-22.6,0 L232,285.3V128c0-8.8,7.2-16,16-16s16,7.2,16,16v144.7l46.6,46.6C316.9,325,316.9,335.1,310.6,341.4z
        </Geometry>
    </Window.Resources>

    <Border Margin="20" Background="White" CornerRadius="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Direction="-90" RenderingBias="Quality" ShadowDepth="5" Opacity="0.1"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <StackPanel Grid.Row="0" Margin="30,30,30,20">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <Path Data="{StaticResource History}" 
                          Fill="{StaticResource SecondaryColor}" 
                          Stretch="Uniform" 
                          Height="18" Width="18"/>
                    <TextBlock Name="Lbl_Patient_Records" Text="PATIENT RECORDS" FontSize="10" FontWeight="Black" 
                               Foreground="{StaticResource SecondaryColor}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="LabelWindowTitle" Text="Medical History &amp; Allergies" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                <Rectangle Height="3" Width="40" Fill="{StaticResource BrandGradient}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- 2. Form Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,0">

                    <!-- InnerText / Medical History Section -->
                    <TextBlock Name="Lbl_General_Medical_History" Text="General Medical History" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="0,0,0,8" FontSize="12"/>
                    <TextBox x:Name="TxtHistoryText" Height="250" TextWrapping="Wrap" AcceptsReturn="True" 
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                             Tag="Enter surgeries, chronic illnesses, or family history..."/>

                    <!-- Allergies Section -->
                    <StackPanel Margin="0,25,0,20">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Ellipse Width="8" Height="8" Fill="#FF5F57" Margin="0,0,8,0"/>
                            <TextBlock Name="Lbl_Alergies" Text="Allergies &amp; Intolerances" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" FontSize="12"/>
                        </StackPanel>
                        <TextBox x:Name="TxtAllergies" Height="150" TextWrapping="Wrap" AcceptsReturn="True" 
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 Tag="e.g. Penicillin, Peanuts, Latex..."
                                 Background="#FFF8F8" BorderBrush="#FED7D7"/>
                    </StackPanel>

                    <!-- Info Box -->
                    <Border Background="#EBF8FF" CornerRadius="10" Padding="15">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ℹ" Foreground="#3182CE" FontWeight="Bold" Margin="0,0,10,0"/>
                            <TextBlock Name="Lbl_EnsureAllDrug" Text="Ensure all known drug allergies are updated to prevent prescription errors." 
                                       FontSize="12" Foreground="#2C5282" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- 3. Footer Buttons -->
            <Border Grid.Row="2" Background="#FAFBFC" CornerRadius="0,0,20,20" Padding="30,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Name="BTN_Discard"  Content="Discard Changes" Click="Cancel_Click" Grid.Column="0" Margin="0,0,10,0" 
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextGrey}" FontWeight="SemiBold" Cursor="Hand"/>

                    <Button x:Name="BTN_Save" Content="Save Patient History" Click="Save_Click" Grid.Column="1" Height="45"
                            Background="{StaticResource BrandGradient}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
