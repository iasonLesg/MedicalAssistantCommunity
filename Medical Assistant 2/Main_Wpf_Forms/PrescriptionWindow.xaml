<Window x:Class="MedicalAssistantCommunity.PrescriptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prescription Editor" Height="580" Width="450"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- Re-using the same modern TextBox style -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#FAFBFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Style.Resources>
        </Style>
    </Window.Resources>

    <Border Margin="20" Background="White" CornerRadius="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Direction="-90" RenderingBias="Quality" ShadowDepth="5" Opacity="0.1"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="*"/>
                <!-- Inputs -->
                <RowDefinition Height="Auto"/>
                <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- 1. Header with Icon -->
            <StackPanel Grid.Row="0" Margin="30,30,30,20">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <Path Data="{StaticResource PrescriptionPath}" 
      Fill="{StaticResource SecondaryColor}" 
      Stretch="Uniform" 
      Height="20" Width="20"/>
                    <TextBlock Name="Label_PRESCRIPTION_DETAILS" Text="PRESCRIPTION DETAILS" FontSize="10" FontWeight="Black" 
                               Foreground="{StaticResource SecondaryColor}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Name="LabelWindowTitle" Text="Issue Prescription" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                <Rectangle Height="3" Width="40" Fill="{StaticResource BrandGradient}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                <Button Name="DeleteBtn" HorizontalAlignment="Right" VerticalAlignment="Top" 
Background="Transparent" BorderThickness="0" Cursor="Hand"
Click="Delete_Click">
                    <!-- Ensure you have a Delete_Click event in .cs -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Name="BtnDelPRescription" Text="Delete prescription" VerticalAlignment="Center" 
           Foreground="#E53E3E" FontSize="12" FontWeight="SemiBold" Margin="0,0,8,0"/>
                        <Path Data="{StaticResource DeleteIconPath}" 
      Fill="#E53E3E" 
      Stretch="Uniform" 
      Height="18" Width="18"/>
                    </StackPanel>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Opacity" Value="0.7"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <!-- 2. Form Content -->
            <StackPanel Grid.Row="1" Margin="30,0">

                <TextBlock Name="Label_Medication_Name"  Text="Medication Name" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="0,0,0,8" FontSize="12"/>
                <TextBox x:Name="TxtPrescriptionName" Margin="0,0,0,20" Tag="e.g. Amoxicillin 500mg"/>

                <TextBlock Name="Label_Dosage_Instruction" Text="Dosage &amp; Instructions" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="0,0,0,8" FontSize="12"/>
                <TextBox x:Name="TxtDetails" Height="120" TextWrapping="Wrap" AcceptsReturn="True" 
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>

                <Grid Margin="0,20,0,0">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Name="Label_Release_Date" Text="Release Date" FontSize="11" Foreground="{StaticResource TextGrey}"/>
                        <TextBlock x:Name="LblReleaseDate" Text="01/01/2024" FontSize="13" Foreground="{StaticResource TextDark}" FontWeight="SemiBold"/>

                        
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right">
                        <RadioButton x:Name="rb_Active" 
                 GroupName="MainGroup"
                 IsChecked="True"
                 Click="RadioButton_Click"
                 Template="{StaticResource ThemeRadioTemplate}"
                 HorizontalContentAlignment="Center" Width="81" RenderTransformOrigin="0.387,0.504">
                            <!-- Ensures content centers in wide space -->

                            <RadioButton.Content>
                                <!-- 1. REMOVED Width="103" and added MinWidth/Padding -->
                                <StackPanel HorizontalAlignment="Center" 
                        VerticalAlignment="Center" 
                        MinWidth="120" 
                        Margin="10,0">

                                    <Image Width="40" Height="40" Margin="-25,0,0,0">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Source" Value="{StaticResource IconPrescriptionInActive}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                        <Setter Property="Source" Value="{StaticResource IconPrescriptionActive}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>

                                    <!-- 2. Added TextWrapping and TextAlignment -->
                                    <TextBlock Name="Label_Active_prescription" 
                           Text="செயலற்ற மருந்து சீட்டு" 
                           FontSize="12" 
                           HorizontalAlignment="Center" 
                           TextAlignment="Center"
                           TextWrapping="Wrap" 
                           Margin="5,5,5,0" Width="68" Height="33">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#c4c4c4" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                        <Setter Property="Foreground" Value="#00F4C2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                </StackPanel>
                            </RadioButton.Content>
                        </RadioButton>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- 3. Footer Buttons -->
            <Border Grid.Row="2" Background="#FAFBFC" CornerRadius="0,0,20,20" Padding="30,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Name="BTN_Cancel_Prescription" Content="Discard" Click="Cancel_Click" Grid.Column="0" Margin="0,0,10,0" 
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextGrey}" FontWeight="SemiBold" Cursor="Hand"/>

                    <Button Name="BTN_Save_Prescription" Content="Save Prescription" Click="Save_Click" Grid.Column="1" Height="40"
                            Background="{StaticResource BrandGradient}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>