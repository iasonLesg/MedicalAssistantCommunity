<Window x:Class="MedicalAssistantCommunity.AddPatientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Patient Record" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent">

    <Window.Resources>
        <!-- Prescription SVG Icon Data -->
    

      

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#FAFBFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Style.Resources>
        </Style>
    </Window.Resources>

    <Border Margin="20" Background="White" CornerRadius="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Direction="-90" RenderingBias="Quality" ShadowDepth="5" Opacity="0.1"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header Section -->
            <StackPanel Grid.Row="0" Margin="30,30,30,20">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <Path Data="{StaticResource PersonShape}" 
Fill="{StaticResource SecondaryColor}" 
Stretch="Uniform" 
Height="20" Width="20"/>
                    <TextBlock Name="ModeLabel" Text="REGISTRATION" FontSize="10" FontWeight="Black" 
     Foreground="{StaticResource SecondaryColor}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="WindowTitle" Text="Add New Patient" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                <Rectangle Height="3" Width="40" Fill="{StaticResource BrandGradient}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                <Button Name="BTN_DeleteInterface" HorizontalAlignment="Right" VerticalAlignment="Top" 
Background="Transparent" BorderThickness="0" Cursor="Hand"
Click="Delete_Click">
                    <!-- Ensure you have a Delete_Click event in .cs -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Name="DeletePatientBtn"  Text="Delete diagnosis" VerticalAlignment="Center" 
           Foreground="#E53E3E" FontSize="12" FontWeight="SemiBold" Margin="0,0,8,0"/>
                        <Path Data="{StaticResource DeleteIconPath}" 
      Fill="#E53E3E" 
      Stretch="Uniform" 
      Height="18" Width="18"/>
                    </StackPanel>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Opacity" Value="0.7"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

            </StackPanel>

            <!-- 2. Main Content (Two Columns) -->
            <Grid Grid.Row="1" Margin="30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="350"/>
                    <!-- Left Side: Form -->
                    <ColumnDefinition Width="*"/>
                    <!-- Right Side: Prescriptions -->
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDE: Patient Form -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,20,0">
                        <StackPanel x:Name="TimestampArea" Visibility="Collapsed" Margin="0,0,0,20">
                            <TextBlock Name="Lbl_RegistrationDate" Text="Registration Date" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="0,0,0,8"/>
                            <TextBox x:Name="TxtTimestamp" IsReadOnly="True" Background="#F1F5F9" Foreground="{StaticResource TextGrey}" BorderThickness="0"/>
                        </StackPanel>

                        <TextBlock Name="Lbl_FullName" Text="Full Name" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="0,0,0,8"/>
                        <TextBox x:Name="TxtName" Margin="0,0,0,20"/>

                        <TextBlock Name="Lbl_Gender" Text="Gender" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="0,0,0,8"/>
                        <ComboBox x:Name="ComboSex" Style="{StaticResource ModernComboBox}" Height="38" Margin="0,0,0,20">
                            <ComboBoxItem Content="Undefined" Tag="0"/>
                            <ComboBoxItem Content="Male" Tag="1"/>
                            <ComboBoxItem Content="Female" Tag="2"/>
                        </ComboBox>

                        <TextBlock Name="Lbl_SocialSecurity" Text="Social Security Number" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="0,0,0,8"/>
                        <TextBox x:Name="TxtSSN" Margin="0,0,0,20"/>

                        <TextBlock Name="Lbl_BirthDate" Text="Date of Birth" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBox x:Name="DobDay" MaxLength="2" TextAlignment="Center"/>
                                <TextBlock Name="LBL_Day" Text="Day" FontSize="9" Foreground="{StaticResource TextGrey}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                <ComboBox x:Name="DobMonth" Style="{StaticResource ModernComboBox}" Height="38">
                                    <ComboBoxItem Content="January"/>
                                    <ComboBoxItem Content="February"/>
                                    <ComboBoxItem Content="March"/>
                                    <ComboBoxItem Content="April"/>
                                    <ComboBoxItem Content="May"/>
                                    <ComboBoxItem Content="June"/>
                                    <ComboBoxItem Content="July"/>
                                    <ComboBoxItem Content="August"/>
                                    <ComboBoxItem Content="September"/>
                                    <ComboBoxItem Content="October"/>
                                    <ComboBoxItem Content="November"/>
                                    <ComboBoxItem Content="December"/>
                                </ComboBox>
                                <TextBlock Name="LBL_Month" Text="Month" FontSize="9" Foreground="{StaticResource TextGrey}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="5,0,0,0">
                                <TextBox x:Name="DobYear" MaxLength="4" TextAlignment="Center"/>
                                <TextBlock Name="LBL_Year" Text="Year" FontSize="9" Foreground="{StaticResource TextGrey}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Name="Lbl_Phone" Text="Phone Number" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="0,0,0,8"/>
                        <TextBox x:Name="TxtPhone" Margin="0,0,0,20"/>

                        <Button Click="OpenHistory_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="40" Height="40">
                                    <!-- Using your DrawingImage resource -->
                                    <Image Source="{StaticResource IconHistory}" Stretch="Uniform"/>
                                </Grid>
                                <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock Name="Lbl_PatientHistory" Text="Patient History" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}"/>
                                    <TextBlock Name="Lbl_ViewMedical" Text="View medical timeline" FontSize="11" Foreground="{StaticResource TextGrey}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- RIGHT SIDE: Prescription Gallery -->
                <Border Grid.Column="1" Background="#FAFBFC" CornerRadius="15" Padding="20">
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="20"/>
                            <!-- Spacer -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- TOP: Prescription Gallery -->
                        <Border Grid.Row="0" Background="#FAFBFC" CornerRadius="15" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Name="Lbl_Perscriptions" Text="Prescriptions" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextDark}" Margin="0,0,0,15"/>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ItemsPrescriptions">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="10" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="EditPrescription_Click">
                                                    <StackPanel Width="80">
                                                        <Grid Height="60" Width="50">
                                                            <Path Data="{StaticResource PrescriptionPath}" Stretch="Uniform">
                                                                <Path.Style>
                                                                    <Style TargetType="Path">
                                                                        <Setter Property="Fill" Value="{StaticResource SecondaryColor}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Active}" Value="False">
                                                                                <Setter Property="Fill" Value="#c4c4c4" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                        </Grid>
                                                        <TextBlock Text="{Binding PrescriptionName}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" Foreground="{StaticResource TextDark}"/>
                                                        <TextBlock Text="{Binding TimeReleased, Converter={StaticResource LanguageDateConverter}}" 
           FontSize="9" 
           TextAlignment="Center" 
           Foreground="{StaticResource TextGrey}"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="40" Height="40" Click="AddPrescription_Click" Background="{StaticResource BrandGradient}" BorderThickness="0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="20"/>
                                        </Style>
                                    </Button.Resources>
                                    <TextBlock Text="+" Foreground="White" FontSize="24" FontWeight="Light" Margin="0,0,0,2"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- BOTTOM: Diagnosis Gallery -->
                        <Border Grid.Row="2" Background="#FAFBFC" CornerRadius="15" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Name="Lbl_Diagnosis" Text="Diagnoses" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextDark}" Margin="0,0,0,15"/>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ItemsDiagnoses">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="10" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="EditDiagnosis_Click">
                                                    <StackPanel Width="100">
                                                        <!-- Slightly wider to accommodate longer text -->
                                                        <Grid Height="60" Width="50">
                                                            <Path Data="{StaticResource Diagnosis}" Stretch="Uniform" Fill="{StaticResource SecondaryColor}"/>
                                                        </Grid>

                                                        <!-- Diagnosis Title -->
                                                   

                                                        <!-- Timestamp as Letters -->
                                                        <TextBlock Text="{Binding TimeReleased, Converter={StaticResource LanguageDateConverter}}" 
           FontSize="9" 
           TextAlignment="Center" 
           Foreground="{StaticResource TextGrey}"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="40" Height="40" Click="AddDiagnosis_Click" Background="{StaticResource BrandGradient}" BorderThickness="0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="20"/>
                                        </Style>
                                    </Button.Resources>
                                    <TextBlock Text="+" Foreground="White" FontSize="24" FontWeight="Light" Margin="0,0,0,2"/>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. Footer Action Buttons -->
            <Border Grid.Row="2" Background="#FAFBFC" CornerRadius="0,0,20,20" Padding="30,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Name="BtnCancel" Content="Cancel" Click="Cancel_Click" Grid.Column="0" Margin="0,0,10,0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextGrey}" FontWeight="SemiBold" Cursor="Hand"/>
                    <Button x:Name="BtnSave" Content="Save Registry" Click="Save_Click" Grid.Column="1" Height="45" Background="{StaticResource BrandGradient}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>