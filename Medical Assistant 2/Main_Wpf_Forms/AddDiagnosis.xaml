<Window x:Class="MedicalAssistantCommunity.AddDiagnosis"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diagnosis Editor" Height="1050" Width="1550"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- Style for the text inputs -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#FAFBFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Style.Resources>
        </Style>
    </Window.Resources>

    <Border Margin="20" Background="White" CornerRadius="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Direction="-90" RenderingBias="Quality" ShadowDepth="5" Opacity="0.1"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header with Icon -->
            <StackPanel  Grid.Row="0" Margin="30,30,30,20">
                <StackPanel HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Path Data="{StaticResource Diagnosis}" 
                  Fill="{StaticResource SecondaryColor}" 
                  Stretch="Uniform" 
                  Height="20" Width="20"/>
                        <TextBlock Name="Lbl_Diagnosis_Details" Text="DIAGNOSIS DETAILS" FontSize="10" FontWeight="Black" 
                       Foreground="{StaticResource SecondaryColor}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="LabelWindowTitle" Text="Clinical Diagnosis" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                    <Rectangle Height="3" Width="40" Fill="{StaticResource BrandGradient}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                </StackPanel>
                
                <Button Name="BTN_DeleteInterface" HorizontalAlignment="Right" VerticalAlignment="Top" 
            Background="Transparent" BorderThickness="0" Cursor="Hand"
            Click="Delete_Click">
                    <!-- Ensure you have a Delete_Click event in .cs -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Name="DeleteDiagnosisBtn"  Text="Delete diagnosis" VerticalAlignment="Center" 
                       Foreground="#E53E3E" FontSize="12" FontWeight="SemiBold" Margin="0,0,8,0"/>
                        <Path Data="{StaticResource DeleteIconPath}" 
                  Fill="#E53E3E" 
                  Stretch="Uniform" 
                  Height="18" Width="18"/>
                    </StackPanel>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Opacity" Value="0.7"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

            </StackPanel>

            <!-- 2. Form Content -->
            <StackPanel Grid.Row="1" Margin="30,0">
                <TextBlock Name="Lbl_Cond_Diagn" Text="Condition / Diagnosis" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="0,0,0,8" FontSize="12"/>
                <TextBox x:Name="TxtDiagnosisText" Height="700" TextWrapping="Wrap" AcceptsReturn="True" 
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         Tag="e.g. Acute Respiratory Infection..."/>

                <Grid Margin="0,20,0,0">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Name="Lbl_TimeReleased"  Text="Date Identified" FontSize="11" Foreground="{StaticResource TextGrey}"/>
                        <TextBlock x:Name="LblTimeReleased" Text="01/01/2026" FontSize="13" Foreground="{StaticResource TextDark}" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right">
                       
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- 3. Footer Buttons -->
            <Border Grid.Row="2" Background="#FAFBFC" CornerRadius="0,0,20,20" Padding="30,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Name="BTN_Cancel" Content="Discard" Click="Cancel_Click" Grid.Column="0" Margin="0,0,10,0" 
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextGrey}" FontWeight="SemiBold" Cursor="Hand"/>

                    <Button x:Name="BTN_Save" Content="Save Diagnosis" Click="Save_Click" Grid.Column="1" Height="45"
                            Background="{StaticResource BrandGradient}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>