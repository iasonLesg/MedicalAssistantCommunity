<Window x:Class="MedicalAssistantCommunity.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Medical Assistant" 
        Height="650" Width="1260"
        FontFamily="Segoe UI"
        Background="#F5F7FB"
        Icon="{StaticResource AppIconImage}">
    <Window.Resources>
        
        <SolidColorBrush x:Key="PrimaryAquamarine" Color="#00F4C2"/>
        <SolidColorBrush x:Key="SecondaryBlue" Color="#07B6F7"/>
        <SolidColorBrush x:Key="AppBackground" Color="#F5F7FB"/>
        <SolidColorBrush x:Key="PressedGrey" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextNavy" Color="#1E293B"/>
        <SolidColorBrush x:Key="TextGrey" Color="#64748B"/>

        <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00F4C2" Offset="0.0" />
            <GradientStop Color="#07B6F7" Offset="1.0" />
        </LinearGradientBrush>

        <Style x:Key="MenuButtonStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Navigation"/>
            <Setter Property="Height" Value="55"/>
            <Setter Property="Foreground" Value="{StaticResource TextNavy}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" 
                                Background="White" 
                                BorderBrush="#EEF0F2" 
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Rectangle x:Name="indicator" 
                                           HorizontalAlignment="Left" 
                                           Width="5" 
                                           Fill="{StaticResource SecondaryBlue}" 
                                           Visibility="Collapsed"/>

                                <ContentPresenter HorizontalAlignment="Left" 
                                                  VerticalAlignment="Center" 
                                                  Margin="25,0,0,0"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FAFBFC"/>
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PressedGrey}"/>
                                <Setter TargetName="indicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource SecondaryBlue}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <DockPanel>
                
                <StackPanel DockPanel.Dock="Top" Margin="0,40,0,40">
                    <Viewbox Height="35" Width="35" Stretch="Uniform">
                        <!-- The Grid forces both Paths to occupy the exact same space -->
                        <Grid Width="24" Height="24">

                            <!-- BACKGROUND: The Medical Cross -->
                            <Path Data="{StaticResource MedicalCrossTransparentCenter}" 
                  Fill="{StaticResource lOGOSecondaryColor}" 
                  Stretch="Uniform"/>

                            <!-- FOREGROUND: The Abstract Logo -->
                            <!-- Because this is second, it renders on top -->
                            <Path Data="{StaticResource AbstractElement}" 
                  Fill="{StaticResource lOGOPrimaryColor}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                                <Path.RenderTransform>
                                    <TransformGroup>
                                        <!-- Centers the 14x14 logo inside the 24x24 cross -->
                                        <ScaleTransform ScaleX="1.3" ScaleY="1.4" CenterX="7" CenterY="7"/>
                                        <TranslateTransform X="-0.5" Y="1"/>
                                    </TransformGroup>
                                </Path.RenderTransform>
                            </Path>

                        </Grid>
                    </Viewbox>
                    <TextBlock Text="Medical Assistant" 
               HorizontalAlignment="Center"
               FontSize="20" 
               FontWeight="Black" 
               Foreground="{StaticResource BrandGradient}"/>
                    <Border Background="{StaticResource CommunityBrush}" 
CornerRadius="3" 
Padding="5,1,5,1" 
HorizontalAlignment="Center" 
Margin="0,2,0,0">
                        <TextBlock Text="COMMUNITY EDITION" 
       FontSize="9" 
       FontWeight="ExtraBold" 
                       Background="Transparent"
       Foreground="White" 
       />
                    </Border>
                    <!-- Removed CharacterSpacing to ensure compatibility -->
                    <TextBlock Name="LogoSubTitle" Text="PATIENT DATA MANAGMENT" 
               HorizontalAlignment="Center"
               FontSize="10" 
               FontWeight="SemiBold"
               Foreground="{StaticResource TextGrey}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <RadioButton Name="PatientsRadioBtn" Content="Patients" 
                                 Style="{StaticResource MenuButtonStyle}" 
                                 Tag="0"
                                 IsChecked="True"
                                 Checked="ModeChanged"/>

                    <RadioButton Name="AppointmentRadioBtn" Content="Appointments" Tag="1"
                                 Style="{StaticResource MenuButtonStyle}"
                                 Checked="ModeChanged"/>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Padding="20" Background="#FAFBFC" BorderThickness="0,1,0,0" BorderBrush="#E2E8F0">
                    <Grid>
                        <!-- Left Side: Avatar and Name -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Ellipse Width="35" Height="35" Fill="{StaticResource BrandGradient}"/>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Username}" 
                           FontWeight="Bold" 
                           FontSize="12" 
                           Foreground="{StaticResource TextNavy}"/>
                                <TextBlock Name="LBL_SustemUser" Text="System Manager" 
                           FontSize="10" 
                           Foreground="{StaticResource TextGrey}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Right Side: Settings Button -->
                        <Button HorizontalAlignment="Right" 
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Click="OpenSettings_Click">
                            <Path Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.81,11.69,4.81,12c0,0.31,0.02,0.65,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" 
                  Fill="{StaticResource TextGrey}" 
                  Stretch="Uniform" 
                  Width="18" Height="18"/>
                        </Button>
                    </Grid>
                </Border>
                <Grid/>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="40">
            <!-- Define two rows: Top for header, Bottom for the list -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header row -->
                <RowDefinition Height="*"/>
                <!-- This '*' makes the list fill the remaining screen -->
            </Grid.RowDefinitions>

            <!-- Header Section (Row 0) -->
            <Grid Grid.Row="0" Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Title -->
                    <ColumnDefinition Width="*"/>
                    <!-- Search Box -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Button -->
                </Grid.ColumnDefinitions>

                <!-- Title Group -->
                <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                    <TextBlock Name="LBL_SystemOver" Text="System Overview" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SecondaryBlue}"/>
                    <TextBlock Name="WindowMidTitle" Text="Patient Registry" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextNavy}"/>
                </StackPanel>

                <!-- Search Box -->
                <Border Grid.Column="1" 
                Background="White" 
                CornerRadius="20" 
                Height="40" 
                Margin="40,0,40,5" 
                VerticalAlignment="Bottom"
                BorderBrush="#E2E8F0" 
                BorderThickness="1" Name="SearchBoxGrid">
                    <Grid >
                        <TextBlock Name="SearchPatientsLabel" Text="Search patients..." 
                           Foreground="{StaticResource TextGrey}" 
                           VerticalAlignment="Center" 
                           Margin="15,0"
                           IsHitTestVisible="False"
                           Visibility="{Binding ElementName=SearchInput, Path=Text.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <TextBox Name="SearchInput"
                         Background="Transparent"
                         BorderThickness="0"
                         VerticalContentAlignment="Center"
                         Padding="15,0"
                         FontSize="14"
                         TextChanged="SearchInput_TextChanged"/>
                    </Grid>
                </Border>
                <StackPanel  Grid.Column="1"  Orientation="Horizontal" VerticalAlignment="Bottom" Margin="40,0,40,5"  Name="CalendarBorder" Visibility="Collapsed" >
                    <TextBlock Name="CalendarDropDownLabel" Text="View Range:" 
               VerticalAlignment="Center" 
               Margin="0,0,10,0" 
               FontSize="11" 
               FontWeight="SemiBold" 
               Foreground="{StaticResource TextGrey}"/>

                    <!-- Applying your ModernComboBox Style -->
                    <ComboBox Name="CalendarLengthPicker"
              Style="{StaticResource ModernComboBox}"
              Width="120"
              Height="35"
              SelectionChanged="CalendarLength_Changed">
                        <ComboBoxItem Content="7 Days" Tag="7"/>
                        <ComboBoxItem Content="14 Days" Tag="14" IsSelected="True"/>
                        <ComboBoxItem Content="30 Days" Tag="30"/>
                        <ComboBoxItem Content="3 Months" Tag="90"/>
                    </ComboBox>
                </StackPanel>
                <!-- Register Button -->
                <Button Grid.Column="2" 
                Name="RegisterNew" 
                Content="+ Register New" 
                Click="Add_Click"
                VerticalAlignment="Bottom"
                Background="{StaticResource PrimaryAquamarine}"
                Foreground="White"
                FontWeight="Bold"
                Padding="20,10"
                BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <!-- Patient Area (Row 1) - This will now SCALE and SCROLL -->
            <Border Grid.Row="1" 
            x:Name="PatientContainerBorder" 
            Background="White" 
            CornerRadius="15" 
            Padding="20">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Direction="-90" RenderingBias="Quality" ShadowDepth="2" Opacity="0.05"/>
                </Border.Effect>

                <!-- The ScrollViewer is now constrained by the Grid Row, so it will scroll! -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled">

                    <WrapPanel x:Name="PatientDisplayArea" 
                       Orientation="Horizontal" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>